<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('paper_trail_history.common.models'), models_path %></li>
    <li class="breadcrumb-item"><%= link_to @trackable_model.human_name, model_path(@trackable_model.name) %></li>
    <li class="breadcrumb-item active"><%= t('.breadcrumb', id: @record_id) %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>
    <%= @trackable_model.human_name %> #<%= @record_id %>
    <% if @record.nil? %>
      <span class="badge bg-danger"><%= t('paper_trail_history.display.deleted_badge') %></span>
    <% end %>
  </h1>
  <div>
    <%= link_to t('.all_versions'), versions_model_record_path(@trackable_model.name, @record_id), class: "btn btn-primary" %>
  </div>
</div>

<% if @record %>
  <div class="row mb-4">
    <div class="col-md-8">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title"><%= t('.current_record') %></h5>
          <dl class="row">
            <% displayed_attributes(@record).each do |attr, value| %>
              <dt class="col-sm-3"><%= attr.humanize %>:</dt>
              <dd class="col-sm-9">
                <% if value.nil? %>
                  <em class="text-muted"><%= t('paper_trail_history.display.empty') %></em>
                <% else %>
                  <%= truncate(value.to_s, length: 100) %>
                <% end %>
              </dd>
            <% end %>
          </dl>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0"><%= t('.version_history') %></h5>
    <%= link_to t('.view_all'), versions_model_record_path(@trackable_model.name, @record_id), class: "btn btn-sm btn-outline-primary" %>
  </div>
  <div class="card-body">
    <% if @recent_versions.any? %>
      <%= render "paper_trail_history/shared/versions_table", versions: @recent_versions %>
    <% else %>
      <p class="text-muted"><%= t('.no_versions') %></p>
    <% end %>
  </div>
</div>