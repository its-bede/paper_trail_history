<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to t('paper_trail_history.common.models'), models_path %></li>
    <li class="breadcrumb-item"><%= link_to @trackable_model.human_name, model_path(@trackable_model.name) %></li>
    <li class="breadcrumb-item active"><%= t('.breadcrumb', id: @version.id) %></li>
  </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><%= t('.title') %></h1>
  <div>
    <% if @decorated_version.can_restore? %>
      <%= button_to t('.restore'),
          restore_version_link_path(@version),
          method: :patch,
          form: { data: { pth_confirm: t("paper_trail_history.confirmations.restore_version") } },
          class: "btn btn-warning" %>
    <% end %>
    <%= link_to t('.view_record'), model_record_path(@trackable_model.name, @version.item_id), class: "btn btn-outline-primary" %>
  </div>
</div>

<div class="row">
  <div class="col-md-6 mb-4">
    <div class="card">
      <div class="card-body">
        <h5 class="card-title"><%= t('.version_information') %></h5>
        <dl class="row">
          <dt class="col-sm-4"><%= t('.version_id') %></dt>
          <dd class="col-sm-8"><code><%= @version.id %></code></dd>
          
          <dt class="col-sm-4"><%= t('.event') %></dt>
          <dd class="col-sm-8">
            <span class="badge bg-<%= @decorated_version.event_class %>">
              <i class="bi bi-<%= @decorated_version.event == 'create' ? 'plus' : @decorated_version.event == 'update' ? 'pencil' : 'trash' %>"></i>
              <%= @decorated_version.event_label %>
            </span>
          </dd>
          
          <dt class="col-sm-4"><%= t('.when') %></dt>
          <dd class="col-sm-8"><%= @decorated_version.formatted_created_at %></dd>
          
          <dt class="col-sm-4"><%= t('.who') %></dt>
          <dd class="col-sm-8"><%= @decorated_version.whodunnit_display %></dd>
          
          <dt class="col-sm-4"><%= t('.item') %></dt>
          <dd class="col-sm-8">
            <%= link_to @decorated_version.item_display_name, 
                model_record_path(@trackable_model.name, @version.item_id),
                class: "text-decoration-none" %>
          </dd>
        </dl>
      </div>
    </div>
  </div>

  <div class="col-md-6 mb-4">
    <% if @decorated_version.can_restore? %>
      <div class="card border-warning">
        <div class="card-body">
          <h5 class="card-title text-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <%= t('.restore_title') %>
          </h5>
          <p class="card-text"><%= t('.restore_text_html') %></p>
          <%= button_to t('.restore'),
              restore_version_link_path(@version),
              method: :patch,
              form: { data: { pth_confirm: t("paper_trail_history.confirmations.restore_version") } },
              class: "btn btn-warning" %>
        </div>
      </div>
    <% else %>
      <div class="card border-secondary">
        <div class="card-body">
          <h5 class="card-title text-muted">
            <i class="bi bi-info-circle"></i>
            <%= t('.cannot_restore_title') %>
          </h5>
          <p class="card-text text-muted"><%= t('.cannot_restore_text') %></p>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% if @decorated_version.changed_attributes.any? %>
  <div class="card">
    <div class="card-header">
      <h5 class="mb-0">
        <i class="bi bi-code-square"></i>
        <%= t('.changes_made') %>
      </h5>
    </div>
    <div class="card-body">
      <div class="diff-container">
        <% @decorated_version.changed_attributes.each do |change| %>
          <div class="diff-section mb-4">
            <div class="diff-header">
              <i class="bi bi-at"></i>
              <strong><%= change[:attribute] %></strong>
            </div>
            <div class="diff-content">
              <div class="diff-line diff-removed">
                <span class="diff-marker">-</span>
                <code><%= change[:old_value] %></code>
              </div>
              <div class="diff-line diff-added">
                <span class="diff-marker">+</span>
                <code><%= change[:new_value] %></code>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <div class="card">
    <div class="card-body text-center text-muted">
      <i class="bi bi-info-circle"></i>
      <%= t('.no_changes') %>
    </div>
  </div>
<% end %>